# Copia questo file come  segreti.env  e riempi i valori.
# segreti.env non va mai condiviso: contiene chiavi personali.

# Bot Telegram: il codice lo dà @BotFather quando crei il bot.
TELEGRAM_TOKEN=
# Il numero della tua chat con il bot (vedi README, sezione Telegram).
TELEGRAM_CHAT_ID=

# WordPress: utente e "password per applicazioni"
# (Bacheca > Utenti > Profilo > Password per le applicazioni).
# Non è la tua password vera.
WP_UTENTE=
WP_PASSWORD_APP=
